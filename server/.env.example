# MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/weather_app

# WeatherAI API — https://weather-ai.co/docs (Dashboard → API Keys)
WEATHER_AI_API_KEY=wai_your_key_here

# Set to false to skip Gemini AI summaries and preserve AI quota
WEATHER_AI_AI=true

PORT=5000

# Frontend origin for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Production: set NODE_ENV=production to serve client/dist from Express
# NODE_ENV=production
